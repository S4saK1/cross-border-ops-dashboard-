# 应用配置
SECRET_KEY=your-secret-key-here-at-least-32-characters
# 开发环境默认使用 SQLite（一键启动），生产环境请用 PostgreSQL
DATABASE_URL=sqlite:///./bilingual_cms.db

# 管理员配置
ADMIN_EMAIL=admin@bilingual-cms.com
ADMIN_PASSWORD=your-secure-admin-password

# CORS配置
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 监控配置
ENABLE_MONITORING=true
MONITORING_INTERVAL=60

# 缓存配置
UPLOAD_CACHE_TTL=3600
UPLOAD_CACHE_MAX_SIZE=100

# 环境配置
ENVIRONMENT=development
LOG_LEVEL=INFO

# 数据库连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# PostgreSQL配置（如果使用PostgreSQL）
POSTGRES_USER=bilingual_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=bilingual_cms
POSTGRES_PORT=5432

# Redis配置
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
