{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Extra Fields",
  "description": "Schema for Product.extra_fields dynamic fields",
  "type": "object",
  "properties": {
    "color_hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "ean": {"type": "string", "pattern": "^[0-9]{13}$"},
    "upc": {"type": "string", "pattern": "^[0-9]{12}$"},
    "hs_code": {"type": "string", "pattern": "^[0-9]{4}(\\.[0-9]{2}){0,4}$"},
    "certifications": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "manufacturer": {"type": "string", "maxLength": 200},
    "supplier": {"type": "string", "maxLength": 200},
    "lead_time_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "moq": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
